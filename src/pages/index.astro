---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Eliana Betancur — Design Systems"
  description="Senior UX Engineer with four years of enterprise product experience, growing into design leadership."
>
  <div class="min-h-[calc(100vh-80px)] flex items-start pt-8 pb-20 px-6 sm:px-10">
    <div class="w-full page-reveal">
      <div class="text-center mb-14">
        <h1
          class="font-display font-bold text-5xl sm:text-6xl md:text-7xl leading-[1.05] mb-2 text-rust-500"
        >
          Eliana Betancur
        </h1>
        <p class="font-mono text-sm text-warmgray-500 tracking-widest">
          UX Engineer · Design Systems
        </p>
      </div>

      <div class="mt-14">
        <p
          class="font-mono text-xs text-warmgray-500 mb-4 uppercase tracking-widest"
        >
          Work
        </p>
        <a href="/ds" class="group block">
          <div
            class="bg-white rounded-xl overflow-hidden grid grid-cols-1 sm:grid-cols-2 border border-warmgray-200 hover:border-warmgray-400 transition-colors"
          >
            <!-- Left: info -->
            <div class="p-8">
              <p
                class="font-mono text-xs text-rust-600 uppercase tracking-widest mb-3"
              >
                Case Study · Design Systems
              </p>
              <h2
                class="font-display font-bold text-2xl text-warmgray-800 mb-3"
              >
                Betancur DS
              </h2>
              <p
                class="font-sans text-sm text-warmgray-600 leading-relaxed mb-6"
              >
                Scaling a fragmented design system to org-wide adoption at
                UnitedHealthcare through documentation, accessibility, and
                engineering partnership.
              </p>
              <div class="flex flex-wrap gap-2 mb-6">
                <span
                  class="font-mono text-xs px-3 py-1 rounded-full border border-warmgray-300 text-warmgray-600"
                  >Token architecture</span
                >
                <span
                  class="font-mono text-xs px-3 py-1 rounded-full border border-warmgray-300 text-warmgray-600"
                  >WCAG 2.1 AA</span
                >
                <span
                  class="font-mono text-xs px-3 py-1 rounded-full border border-warmgray-300 text-warmgray-600"
                  >14 components</span
                >
                <span
                  class="font-mono text-xs px-3 py-1 rounded-full border border-warmgray-300 text-warmgray-600"
                  >Figma</span
                >
              </div>
              <span
                class="font-mono text-sm text-rust-600 underline underline-offset-4 group-hover:text-rust-500 transition-colors"
                >View case study →</span
              >
            </div>

            <!-- Right: token grid visual -->
            <div
              class="bg-warmgray-200 relative overflow-hidden"
              style="min-height:400px"
            >
              <img
                src="/ds-preview.png"
                alt="Betancur DS design system preview"
                class="absolute inset-0 w-full h-full object-cover object-top"
              />
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <style>
    .page-reveal {
      animation: rise 0.6s ease-out both;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .page-reveal {
        animation: none;
      }
    }
  </style></Layout
>
