---
import Layout from '../layouts/layout.astro';
---

<Layout title="Eliana Betancur — Design Systems" description="Eliana Betancur — design systems strategist bridging design intent and engineering reality.">
  <div class="min-h-[calc(100vh-80px)] flex items-center px-6 sm:px-10">
    <div class="w-full page-reveal">
      <h1 class="font-display font-bold text-5xl sm:text-6xl md:text-7xl leading-[1.05] mb-6">
        I think in systems.
      </h1>
      <p class="font-sans text-lg sm:text-xl text-warmgray-600 leading-relaxed mb-14">
        Strategic design systems work that bridges design intent and engineering reality, so good decisions scale across the whole product, not just one screen.
      </p>
      <div>
        <p class="font-mono text-xs text-warmgray-500 mb-4 uppercase tracking-widest">Work</p>
        <a href="/ds" class="group flex items-center gap-4">
          <span class="inline-block w-2.5 h-2.5 bg-rust-500 flex-shrink-0" aria-hidden="true"></span>
          <span class="font-sans text-base text-warmgray-700 group-hover:text-warmgray-800 transition-colors">Betancur DS — Design Systems at UnitedHealthcare</span>
          <span class="font-mono text-sm text-warmgray-400 group-hover:text-rust-600 transition-colors">→</span>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-reveal {
    animation: rise 0.6s ease-out both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-reveal { animation: none; }
  }
</style>