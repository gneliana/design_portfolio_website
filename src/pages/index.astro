---
import Layout from '../layouts/layout.astro';
---

<Layout title="Eliana Betancur — Design Systems" description="Senior UX Engineer with four years of enterprise product experience, growing into design leadership.">
  <div class="min-h-[calc(100vh-80px)] flex items-start pt-8 px-6 sm:px-10">
    <div class="w-full page-reveal">

      <div class="text-center mb-14">
        <h1 class="font-display font-bold text-5xl sm:text-6xl md:text-7xl leading-[1.05] mb-2 text-rust-500">
          Eliana Betancur
        </h1>
        <p class="font-mono text-sm text-warmgray-500 tracking-widest">UX Engineer · Design Systems</p>
      </div>

      <div class="text-left">
        <p class="font-mono text-xs text-warmgray-500 mb-4 uppercase tracking-widest">Work</p>
        <a href="/ds" class="group flex items-center gap-4">
          <span class="inline-block w-2.5 h-2.5 bg-rust-500 flex-shrink-0" aria-hidden="true"></span>
          <span class="font-sans text-base text-warmgray-700 group-hover:text-warmgray-800 transition-colors">Betancur DS — Design Systems at UnitedHealthcare</span>
          <span class="font-mono text-sm text-warmgray-400 group-hover:text-rust-600 transition-colors">→</span>
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
  .page-reveal {
    animation: rise 0.6s ease-out both;
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-reveal { animation: none; }
  }
</style>